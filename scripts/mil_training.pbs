#!/bin/bash
#PBS -N mil_train
# scratch_local: 10gb default; use 100gb when COPY_TO_SCRATCH=1 (override via qsub -l)
#PBS -l select=1:ncpus=4:mem=128gb:ngpus=1:scratch_local=10gb:gpu_mem=10gb
#PBS -l walltime=24:00:00
#
# Submit from MIL repo on cluster (no wrapper script needed). -V passes your shell env into the job.
# Required: FEAT_DIR. FEATURE_DIM is optional when ENCODER is set.
# Optional: CONFIG=/abs/config.yaml to load YAML defaults before env overrides.
# Other knobs: ENCODER, MODEL, EPOCHS, PATIENCE, PATCH_DROPOUT, FOLDS, PRELOAD, etc.
#
# Fair comparison recipe (same as historical mil_train_* logs, e.g. gated job 18468804):
#   cd /storage/brno2/home/filipsec/MIL
#   export COPY_TO_SCRATCH=1 PRELOAD=1
#   export MODEL=gated                    # or: attention | ordinal | clam
#   export ENCODER=gigapath               # or: hoptimus0 | hoptimus1 | uni2 | virchow2 | conch
#   export FEAT_DIR=.../features_virchow2 # or .../features_uni_v2
#   # FEATURE_DIM is derived from ENCODER when ENCODER is set
#   export RUN_NAME=my_run_clam           # optional stable checkpoint dir name
#   export CLAM_INST_WEIGHT=0.7           # only used when MODEL=clam
#   qsub -V -l "select=1:ncpus=4:mem=128gb:ngpus=1:scratch_local=100gb:gpu_mem=10gb" scripts/mil_training.pbs
#
# CLAM on both encoders: two separate qsub (swap FEAT_DIR/FEATURE_DIM each time).
#
# COPY_TO_SCRATCH=1: request more node scratch on submit (replaces select in this file on MetaCentrum):
#   export COPY_TO_SCRATCH=1
# qsub -V -l "select=1:ncpus=4:mem=128gb:ngpus=1:scratch_local=100gb:gpu_mem=10gb" scripts/mil_training.pbs

set -euo pipefail

MIL="/storage/brno2/home/filipsec/MIL"
CONFIG="${CONFIG:-}"
FEAT_DIR="${FEAT_DIR:-}"
FEATURE_DIM="${FEATURE_DIM:-}"
ENCODER="${ENCODER:-}"
COORDS_DIR="${COORDS_DIR:-}"
MODEL="${MODEL:-}"
EPOCHS="${EPOCHS:-}"
PATIENCE="${PATIENCE:-}"
PATCH_DROPOUT="${PATCH_DROPOUT:-}"
BATCH_SIZE="${BATCH_SIZE:-}"
TOP_K="${TOP_K:-}"
FOLDS="${FOLDS:-}"
NUM_WORKERS="${NUM_WORKERS:-}"
MAX_PATCHES_TRAIN="${MAX_PATCHES_TRAIN:-}"
MAX_PATCHES_VAL="${MAX_PATCHES_VAL:-}"
LR="${LR:-}"
WARMUP_EPOCHS="${WARMUP_EPOCHS:-}"
CE_WEIGHT="${CE_WEIGHT:-}"
HIDDEN="${HIDDEN:-}"
ATTENTION_DIR="${ATTENTION_DIR:-}"
PRELOAD="${PRELOAD:-}"
COPY_TO_SCRATCH="${COPY_TO_SCRATCH:-0}"
RESUME="${RESUME:-}"
SEED="${SEED:-}"
CLAM_INST_WEIGHT="${CLAM_INST_WEIGHT:-}"
TRAIN_CSV="${TRAIN_CSV:-}"
SPLITS_CSV="${SPLITS_CSV:-}"

TRIDENT_ENV="/storage/brno2/home/filipsec/.conda/envs/trident"
PYTHON="$TRIDENT_ENV/bin/python"
REGISTRY_PY="$MIL/scripts/encoder_registry.py"
CONFIG_CLI="$MIL/scripts/config_cli.py"

mkdir -p "$MIL/logs" "$MIL/checkpoints"
LOGFILE="$MIL/logs/mil_train_${PBS_JOBID:-manual}.log"
exec > >(stdbuf -oL tee -a "$LOGFILE") 2>&1

timestamp() { date "+%Y-%m-%d %H:%M:%S"; }
log() { echo "[$(timestamp)] $*"; }

clean_scratch() {
    log "[CLEANUP] starting"
    if [[ -n "${SCRATCHDIR:-}" && -d "${SCRATCHDIR:-}" ]]; then
        find "$SCRATCHDIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
    fi
    log "[CLEANUP] done"
}
clean_scratch_if_ok() {
    if [[ "${1:-1}" -eq 0 ]]; then
        clean_scratch
    else
        log "[CLEANUP] skipping (job failed, keeping scratch for debug)"
    fi
}
on_exit() {
    status=$?
    if [[ -n "${CKPT_DIR:-}" && -f "$CKPT_DIR/run_meta.txt" ]]; then
        echo "END_TIME=$(date '+%Y-%m-%d %H:%M:%S')" >> "$CKPT_DIR/run_meta.txt"
        echo "EXIT_STATUS=$status" >> "$CKPT_DIR/run_meta.txt"
    fi
    clean_scratch_if_ok "$status"
}
trap on_exit EXIT
trap 'log "[SIGNAL] TERM received"; exit 143' TERM

# Validation
[[ -x "$PYTHON" ]] || { log "ERROR: python not found or not executable: $PYTHON"; exit 1; }
[[ -f "$CONFIG_CLI" ]] || { log "ERROR: config helper missing: $CONFIG_CLI"; exit 1; }
CONFIG_ARGS=()
if [[ -n "$CONFIG" ]]; then
    CONFIG_ARGS=(--config "$CONFIG")
fi
eval "$("$PYTHON" "$CONFIG_CLI" exports --pipeline mil_training "${CONFIG_ARGS[@]}")"
if [[ -n "$CONFIG" ]]; then
    FEAT_DIR="${FEAT_DIR:-${CFG_FEAT_DIR:-}}"
    FEATURE_DIM="${FEATURE_DIM:-${CFG_FEATURE_DIM:-}}"
    ENCODER="${ENCODER:-${CFG_ENCODER_NAME:-${CFG_ENCODER:-}}}"
    COORDS_DIR="${COORDS_DIR:-${CFG_COORDS_DIR:-}}"
    MODEL="${MODEL:-${CFG_MODEL:-gated}}"
    EPOCHS="${EPOCHS:-${CFG_EPOCHS:-30}}"
    PATIENCE="${PATIENCE:-${CFG_PATIENCE:-10}}"
    PATCH_DROPOUT="${PATCH_DROPOUT:-${CFG_PATCH_DROPOUT:-0.0}}"
    BATCH_SIZE="${BATCH_SIZE:-${CFG_BATCH_SIZE:-4}}"
    TOP_K="${TOP_K:-${CFG_TOP_K:-8}}"
    FOLDS="${FOLDS:-${CFG_FOLDS:-}}"
    NUM_WORKERS="${NUM_WORKERS:-${CFG_NUM_WORKERS:-4}}"
    MAX_PATCHES_TRAIN="${MAX_PATCHES_TRAIN:-${CFG_MAX_PATCHES_TRAIN:-512}}"
    MAX_PATCHES_VAL="${MAX_PATCHES_VAL:-${CFG_MAX_PATCHES_VAL:-512}}"
    LR="${LR:-${CFG_LR:-0.01}}"
    WARMUP_EPOCHS="${WARMUP_EPOCHS:-${CFG_WARMUP_EPOCHS:-5}}"
    CE_WEIGHT="${CE_WEIGHT:-${CFG_CE_WEIGHT:-0.3}}"
    ATTENTION_DIR="${ATTENTION_DIR:-${CFG_ATTENTION_DIR:-}}"
    PRELOAD="${PRELOAD:-${CFG_PRELOAD:-}}"
    RESUME="${RESUME:-${CFG_RESUME:-}}"
    SEED="${SEED:-${CFG_SEED:-42}}"
    CLAM_INST_WEIGHT="${CLAM_INST_WEIGHT:-${CFG_CLAM_INST_WEIGHT:-0.7}}"
    TRAIN_CSV="${TRAIN_CSV:-${CFG_TRAIN_CSV:-$MIL/data/raw/train.csv}}"
    SPLITS_CSV="${SPLITS_CSV:-${CFG_SPLITS_CSV:-$MIL/data/splits/panda_5fold_stratified.csv}}"
else
    MODEL="${MODEL:-gated}"
    EPOCHS="${EPOCHS:-30}"
    PATIENCE="${PATIENCE:-10}"
    PATCH_DROPOUT="${PATCH_DROPOUT:-0.0}"
    BATCH_SIZE="${BATCH_SIZE:-4}"
    TOP_K="${TOP_K:-8}"
    NUM_WORKERS="${NUM_WORKERS:-4}"
    MAX_PATCHES_TRAIN="${MAX_PATCHES_TRAIN:-512}"
    MAX_PATCHES_VAL="${MAX_PATCHES_VAL:-512}"
    LR="${LR:-0.01}"
    WARMUP_EPOCHS="${WARMUP_EPOCHS:-5}"
    CE_WEIGHT="${CE_WEIGHT:-0.3}"
    SEED="${SEED:-42}"
    CLAM_INST_WEIGHT="${CLAM_INST_WEIGHT:-0.7}"
    TRAIN_CSV="${TRAIN_CSV:-$MIL/data/raw/train.csv}"
    SPLITS_CSV="${SPLITS_CSV:-$MIL/data/splits/panda_5fold_stratified.csv}"
fi
if [[ -n "$ENCODER" ]]; then
    [[ -f "$REGISTRY_PY" ]] || { log "ERROR: encoder registry helper missing: $REGISTRY_PY"; exit 1; }
    eval "$("$PYTHON" "$REGISTRY_PY" exports --encoder "$ENCODER")"
    ENCODER="$ENCODER_KEY"
    [[ -n "$FEATURE_DIM" ]] || FEATURE_DIM="$ENCODER_FEATURE_DIM"
fi
[[ -n "$FEAT_DIR" ]] || { log "ERROR: Set FEAT_DIR"; exit 1; }
[[ -d "$FEAT_DIR" ]] || { log "ERROR: FEAT_DIR not found: $FEAT_DIR"; exit 1; }
[[ -n "$FEATURE_DIM" ]] || { log "ERROR: Set FEATURE_DIM or ENCODER"; exit 1; }
N_H5=$(find "$FEAT_DIR" -maxdepth 1 -name '*.h5' 2>/dev/null | wc -l)
log "H5 count in FEAT_DIR: $N_H5"
[[ "$N_H5" -gt 0 ]] || { log "ERROR: no .h5 files in FEAT_DIR"; exit 1; }

log "PRELOAD=$PRELOAD COPY_TO_SCRATCH=$COPY_TO_SCRATCH"

# TMPDIR: nodes have ~1 GB quota outside scratch; Python/h5py/torch use /tmp by default
[[ -n "${SCRATCHDIR:-}" && -d "${SCRATCHDIR:-}" ]] && export TMPDIR="$SCRATCHDIR"

# Copy FEAT_DIR to scratch (MetaCentrum: avoid I/O on central storage)
if [[ "$COPY_TO_SCRATCH" == "1" && -n "${SCRATCHDIR:-}" && -d "${SCRATCHDIR:-}" ]]; then
    FEAT_SCRATCH="$SCRATCHDIR/features"
    log "Copying FEAT_DIR to $FEAT_SCRATCH (local SSD)..."
    t0=$(date +%s)
    cp -r "$FEAT_DIR" "$FEAT_SCRATCH"
    FEAT_DIR="$FEAT_SCRATCH"
    export FEAT_DIR
    log "Copy done in $(($(date +%s) - t0))s. FEAT_DIR=$FEAT_DIR"
fi

# Experiment-specific checkpoint dir (override with RUN_NAME)
SAFE_BASENAME="$(basename "$FEAT_DIR" | tr '/: ' '___')"
RUN_PREFIX="${ENCODER:-$SAFE_BASENAME}"
RUN_NAME="${RUN_NAME:-${RUN_PREFIX}_${MODEL}_e${EPOCHS}_pd${PATCH_DROPOUT}_$(date +%Y%m%d_%H%M%S)}"
CKPT_DIR="$MIL/checkpoints/$RUN_NAME"
mkdir -p "$CKPT_DIR"
log "CKPT_DIR=$CKPT_DIR"

# Metadata file for forensics
cat > "$CKPT_DIR/run_meta.txt" <<EOF
RUN_NAME=$RUN_NAME
CONFIG_NAME=${CONFIG_NAME:-}
CONFIG_PATH=${CONFIG_PATH:-}
FEAT_DIR=$FEAT_DIR
FEATURE_DIM=$FEATURE_DIM
TRAIN_CSV=$TRAIN_CSV
SPLITS_CSV=$SPLITS_CSV
ENCODER_NAME=${ENCODER:-}
ENCODER_REPO_ID=${ENCODER_REPO_ID:-}
COORDS_DIR=${COORDS_DIR:-}
MODEL=$MODEL
EPOCHS=$EPOCHS
PATIENCE=$PATIENCE
PATCH_DROPOUT=$PATCH_DROPOUT
BATCH_SIZE=$BATCH_SIZE
NUM_WORKERS=$NUM_WORKERS
MAX_PATCHES_TRAIN=$MAX_PATCHES_TRAIN
MAX_PATCHES_VAL=$MAX_PATCHES_VAL
LR=$LR
WARMUP_EPOCHS=$WARMUP_EPOCHS
CE_WEIGHT=$CE_WEIGHT
FOLDS=${FOLDS:-all}
GIT_COMMIT=$(git -C "$MIL" rev-parse HEAD 2>/dev/null || echo N/A)
START_TIME=$(date "+%Y-%m-%d %H:%M:%S")
EOF

log "Node: $(hostname)"
log "PBS_JOBID=${PBS_JOBID:-N/A}"
log "CONFIG_NAME=${CONFIG_NAME:-default} CONFIG_PATH=${CONFIG_PATH:-$MIL/configs/pipelines/mil_training.yaml}"
log "FEAT_DIR=$FEAT_DIR FEATURE_DIM=$FEATURE_DIM ENCODER=${ENCODER:-unknown} COORDS_DIR=${COORDS_DIR:-}"
if [[ -n "${ENCODER_REPO_ID:-}" ]]; then
    log "ENCODER_REPO_ID=$ENCODER_REPO_ID"
fi
log "MODEL=$MODEL EPOCHS=$EPOCHS PATIENCE=$PATIENCE PATCH_DROPOUT=$PATCH_DROPOUT BATCH_SIZE=$BATCH_SIZE FOLDS=${FOLDS:-all}"
log "NUM_WORKERS=$NUM_WORKERS MAX_PATCHES_TRAIN=$MAX_PATCHES_TRAIN MAX_PATCHES_VAL=$MAX_PATCHES_VAL"
log "Git commit: $(git -C "$MIL" rev-parse HEAD 2>/dev/null || echo N/A)"
log "Git status:"
git -C "$MIL" status --short 2>/dev/null || true
git -C "$MIL" diff --stat 2>/dev/null || true

nvidia-smi || true

log "Python: $PYTHON"
"$PYTHON" --version
"$PYTHON" - <<'PY'
import torch
print("PyTorch:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())
if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
PY

export FEAT_DIR FEATURE_DIM
"$PYTHON" - <<'PY'
import glob, h5py, os
feat_dir = os.environ["FEAT_DIR"]
expected_dim = int(os.environ["FEATURE_DIM"])
files = sorted(glob.glob(os.path.join(feat_dir, "*.h5")))
assert files, "No .h5 files found"
for f in files[:3]:
    with h5py.File(f, "r") as h:
        assert "features" in h, f"Missing features in {f}"
        feats = h["features"]
        assert feats.ndim == 2, f"features ndim != 2 in {f}"
        assert feats.shape[0] > 0, f"zero patches in {f}"
        assert feats.shape[1] == expected_dim, f"features dim {feats.shape[1]} != FEATURE_DIM {expected_dim}"
        if "coords" in h:
            coords = h["coords"]
            assert coords.ndim == 2, f"coords ndim != 2 in {f}"
            assert coords.shape[0] == feats.shape[0], f"coords/features mismatch in {f}"
        print("SANITY", os.path.basename(f), feats.shape)
print("feature sanity OK")
PY

cd "$MIL"
"$PYTHON" -c "from mil.train import run_cv; print('mil package OK')"

ARGS=(
    --feat-dir "$FEAT_DIR"
    --train-csv "$TRAIN_CSV"
    --splits-csv "$SPLITS_CSV"
    --model "$MODEL"
)
if [[ -n "$COORDS_DIR" ]]; then
    ARGS+=(--coords-dir "$COORDS_DIR")
fi
ARGS+=(
    --epochs "$EPOCHS"
    --patience "$PATIENCE"
    --patch-dropout "$PATCH_DROPOUT"
    --batch-size "$BATCH_SIZE"
    --top-k "$TOP_K"
    --num-workers "$NUM_WORKERS"
    --max-patches-train "$MAX_PATCHES_TRAIN"
    --max-patches-val "$MAX_PATCHES_VAL"
    --lr "$LR"
    --warmup-epochs "$WARMUP_EPOCHS"
    --ce-weight "$CE_WEIGHT"
    --seed "$SEED"
    --checkpoint-dir "$CKPT_DIR"
)
[[ -n "$HIDDEN" ]] && ARGS+=(--hidden "$HIDDEN")
[[ -n "$ATTENTION_DIR" ]] && ARGS+=(--attention-dir "$ATTENTION_DIR")
[[ -n "$ENCODER" ]] && ARGS+=(--encoder-name "$ENCODER")
[[ -n "$CONFIG" ]] && ARGS+=(--config "$CONFIG")
# Only PRELOAD=1 enables RAM cache (PRELOAD=0 must not pass --preload)
[[ "${PRELOAD:-}" == "1" ]] && ARGS+=(--preload)
[[ -n "$RESUME" ]] && ARGS+=(--resume "$RESUME")
[[ "${MODEL:-}" == "clam" ]] && ARGS+=(--clam-inst-weight "$CLAM_INST_WEIGHT")
if [[ -n "$FOLDS" ]]; then
    read -r -a FOLD_ARR <<< "${FOLDS//,/ }"
    ARGS+=(--folds "${FOLD_ARR[@]}")
fi

log "Run command: $PYTHON scripts/run_training.py ${ARGS[*]}"
log "Starting training"
PYTHONUNBUFFERED=1 "$PYTHON" scripts/run_training.py "${ARGS[@]}"
log "Done: $(date)"
