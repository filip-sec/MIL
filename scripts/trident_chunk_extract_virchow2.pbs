#!/bin/bash
#PBS -N trident_virchow2
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:scratch_local=64gb:gpu_mem=10gb
#PBS -l walltime=12:00:00
#
# Same chunked workflow as trident_chunk_extract.pbs but with Virchow2 encoder:
#   --patch_encoder virchow2 --patch_size 224 --mag 20
# Requires TRIDENT to support "virchow2" as a patch encoder (add it in the TRIDENT repo if missing).
# HF_TOKEN read from $MIL/.hf_token or ~/.hf_token (not passed via PBS for security).
# Submit: qsub -v CHUNK_CSV=/path/to/panda_chunk_XXX.csv this_script.pbs
#
# Features output: TRIDENT may write under e.g. $JOB_DIR/20x_224px_0px_overlap/features_virchow2/
# Virchow2 embedding dim = 2560. In the notebook set feat_dir to that path and feat_dim=2560.

set -uo pipefail
trap 'clean_scratch' TERM EXIT

CHUNK_CSV="${CHUNK_CSV:?CHUNK_CSV not set}"
JOB_DIR="/storage/brno2/home/filipsec/MIL/data/trident_out/panda_virchow2_grandqc_20x_224_ov0"
WSI_DIR="/storage/brno2/home/filipsec/MIL/data/raw/train_images"
REPO_DIR="/storage/brno2/home/filipsec/repos/trident"
CONDA_ENV="/storage/brno2/home/filipsec/.conda/envs/trident"
BRNO2_HOME="/storage/brno2/home/filipsec"

mkdir -p /storage/brno2/home/filipsec/MIL/logs
echo "Node: $(hostname)"
echo "Start: $(date)"

source "$BRNO2_HOME/.conda/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

cd "$REPO_DIR"

if [[ -n "${HF_TOKEN:-}" ]]; then
  python -c "from huggingface_hub import login; login(token='$HF_TOKEN'); print('HF login OK')"
fi

# Copy WSIs for this chunk to local scratch for faster IO
echo "CHUNK_CSV=$CHUNK_CSV"
echo "JOB_DIR=$JOB_DIR"
echo "Original WSI_DIR=$WSI_DIR"
echo "SCRATCHDIR=$SCRATCHDIR"

mkdir -p "$SCRATCHDIR/wsis"
awk -F',' 'NR>1 {print $1}' "$CHUNK_CSV" | while read -r name; do
  base="$name"
  if [[ "$base" != *.tif && "$base" != *.tiff ]]; then
    base="${base}.tiff"
  fi
  src="${WSI_DIR}/${base}"
  if [[ -f "$src" ]]; then
    cp "$src" "$SCRATCHDIR/wsis/" || true
  else
    echo "WARNING: missing WSI $src" >&2
  fi
done

WSI_DIR="$SCRATCHDIR/wsis"
echo "Using local WSI_DIR=$WSI_DIR"

nvidia-smi

python run_batch_of_slides.py \
  --task all \
  --wsi_dir "$WSI_DIR" \
  --job_dir "$JOB_DIR" \
  --custom_list_of_wsis "$CHUNK_CSV" \
  --wsi_ext .tiff \
  --segmenter grandqc \
  --patch_encoder virchow2 \
  --mag 20 \
  --patch_size 224 \
  --overlap 0 \
  --gpu 0 \
  --max_workers 4 \
  --feat_batch_size 160 \
  --wsi_cache "$SCRATCHDIR/wsi_cache" \
  --cache_batch_size 12 \
  --remove_artifacts \
  --skip_errors

echo "Done: $(date)"
