#!/bin/bash
#PBS -N trident_single
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:scratch_local=64gb:gpu_mem=10gb:brno=True
#PBS -l walltime=06:00:00
#PBS -o /storage/brno2/home/filipsec/MIL/logs/trident_single_%j.o
#PBS -e /storage/brno2/home/filipsec/MIL/logs/trident_single_%j.e

set -uo pipefail

CHUNK_CSV="${CHUNK_CSV:?CHUNK_CSV not set}"
JOB_DIR="/storage/brno2/home/filipsec/MIL/data/trident_out_single/163fabe883fcd17de4f899ca8ede45a8_noqc"
WSI_DIR="/storage/brno2/home/filipsec/MIL/data/raw/train_images"
REPO_DIR="/storage/brno2/home/filipsec/repos/trident"
CONDA_ENV="/storage/brno2/home/filipsec/.conda/envs/trident"
BRNO2_HOME="/storage/brno2/home/filipsec"

mkdir -p /storage/brno2/home/filipsec/MIL/logs
mkdir -p "$JOB_DIR"

echo "Node: $(hostname)"
echo "Start: $(date)"

source "$BRNO2_HOME/.conda/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

cd "$REPO_DIR"

if [[ -n "${HF_TOKEN:-}" ]]; then
  python -c "from huggingface_hub import login; login(token='$HF_TOKEN'); print('HF login OK')"
fi

echo "CHUNK_CSV=$CHUNK_CSV"
echo "JOB_DIR=$JOB_DIR"
echo "Original WSI_DIR=$WSI_DIR"
echo "SCRATCHDIR=$SCRATCHDIR"

mkdir -p "$SCRATCHDIR/wsis"

awk -F',' 'NR>1 {print $1}' "$CHUNK_CSV" | while read -r name; do
  base="$name"
  if [[ "$base" != *.tif && "$base" != *.tiff ]]; then
    base="${base}.tiff"
  fi
  src="${WSI_DIR}/${base}"
  if [[ -f "$src" ]]; then
    cp "$src" "$SCRATCHDIR/wsis/"
  else
    echo "ERROR: missing WSI $src" >&2
    exit 1
  fi
done

WSI_DIR="$SCRATCHDIR/wsis"
echo "Using local WSI_DIR=$WSI_DIR"

nvidia-smi

# --segmenter hest: fallback (grandqc failed on this slide with "No contour detected")
python run_batch_of_slides.py \
  --task all \
  --wsi_dir "$WSI_DIR" \
  --job_dir "$JOB_DIR" \
  --custom_list_of_wsis "$CHUNK_CSV" \
  --wsi_ext .tiff \
  --segmenter hest \
  --patch_encoder uni_v2 \
  --mag 20 \
  --patch_size 256 \
  --overlap 0 \
  --gpu 0 \
  --max_workers 4 \
  --feat_batch_size 96 \
  --wsi_cache "$SCRATCHDIR/wsi_cache" \
  --cache_batch_size 8 \
  --remove_artifacts \
  --skip_errors

echo "Done: $(date)"

# After job succeeds, copy the .h5 into main production features dir:
# FEAT_MAIN="/storage/brno2/home/filipsec/MIL/data/trident_out/panda_uni_v2_grandqc_20x_256_ov0/20x_256px_0px_overlap/features_uni_v2"
# cp "$JOB_DIR/20x_256px_0px_overlap/features_uni_v2/163fabe883fcd17de4f899ca8ede45a8.h5" "$FEAT_MAIN/"
